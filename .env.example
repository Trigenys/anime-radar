# Copier ce fichier en .env (ignoré par Git) puis remplir avec tes valeurs de my.telegram.org.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=ton_api_hash
# Chaînes qui publient les épisodes (pas les chaînes « sommaire »), séparées par des virgules :
# nom public (MaChaine) ou identifiant numérique d'une chaîne privée (-100…, visible dans l'URL de Telegram Web).
TELEGRAM_CHATS=-1001234567890,MaChainePublique
